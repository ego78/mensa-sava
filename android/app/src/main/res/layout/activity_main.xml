<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F8FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
   android:padding="24dp" android:background="#0867B2">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMUNE DI SAVA"
    android:textColor="#DDEEFF" android:textStyle="bold" android:textSize="13sp"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mensa Scolastica"
    android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="30sp" android:layout_marginTop="5dp"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Servizi online per le famiglie"
    android:textColor="#EAF5FF" android:textSize="16sp" android:layout_marginTop="5dp"/>
  </LinearLayout>

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
   <Button android:id="@+id/login" android:layout_width="match_parent" android:layout_height="62dp"
    android:text="🔐   ACCEDI CON CIE / SPID" android:textStyle="bold" android:textSize="15sp"/>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SERVIZI MENSA"
    android:textColor="#607487" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="24dp" android:layout_marginBottom="8dp"/>

   <Button android:id="@+id/info" android:layout_width="match_parent" android:layout_height="58dp"
    android:text="ℹ   Crediti e informazioni"/>
   <Button android:id="@+id/recharge" android:layout_width="match_parent" android:layout_height="58dp"
    android:layout_marginTop="10dp" android:text="💳   Ricarica credito"/>
   <Button android:id="@+id/diets" android:layout_width="match_parent" android:layout_height="58dp"
    android:layout_marginTop="10dp" android:text="🍎   Diete speciali"/>
   <Button android:id="@+id/assenze" android:layout_width="match_parent" android:layout_height="58dp"
    android:layout_marginTop="10dp" android:text="📅   Gestisci assenze"/>
   <Button android:id="@+id/dashboard" android:layout_width="match_parent" android:layout_height="58dp"
    android:layout_marginTop="10dp" android:text="🏠   Dashboard mensa"/>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="I servizi vengono visualizzati nel pannello interno di Mensa Sava."
    android:textColor="#68798A" android:textSize="12sp" android:gravity="center"
    android:padding="14dp" android:layout_marginTop="18dp"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>