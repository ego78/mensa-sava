<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F9FE" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="245dp" android:background="@drawable/header_gradient">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="22dp" android:paddingTop="30dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏛  COMUNE DI SAVA" android:textColor="#E7F6FF" android:textStyle="bold" android:textSize="13sp"/>
  <TextView android:layout_width="250dp" android:layout_height="wrap_content" android:text="Mensa\nScolastica" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="31sp" android:lineSpacingExtra="-5dp" android:layout_marginTop="6dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Servizi online per le famiglie" android:textColor="#ECF8FF" android:textSize="15sp" android:layout_marginTop="5dp"/>
 </LinearLayout>
 <ImageView android:id="@+id/heroImage" android:layout_width="215dp" android:layout_height="155dp" android:layout_gravity="right|bottom" android:src="@drawable/hero_family" android:scaleType="fitCenter"/>
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingBottom="22dp">
<Button android:id="@+id/login" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="16dp" android:background="@drawable/login_card" android:text="🔒   ACCEDI CON CIE / SPID     ›" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SERVIZI MENSA" android:textColor="#4D6680" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="22dp" android:layout_marginBottom="2dp"/>
<LinearLayout android:id="@+id/infoCard" android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="10dp" android:background="@drawable/card_blue" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:clickable="true" android:focusable="true">
<ImageView android:layout_width="66dp" android:layout_height="66dp" android:src="@drawable/service_info" android:scaleType="centerInside"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crediti e informazioni" android:textColor="#0A376B" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visualizza il saldo e tutte le informazioni utili" android:textColor="#526D88" android:textSize="12sp" android:layout_marginTop="3dp"/>
</LinearLayout><TextView android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="#147BC1" android:textStyle="bold" android:textSize="28sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/rechargeCard" android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="10dp" android:background="@drawable/card_green" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:clickable="true" android:focusable="true">
<ImageView android:layout_width="66dp" android:layout_height="66dp" android:src="@drawable/service_recharge" android:scaleType="centerInside"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ricarica credito" android:textColor="#0A376B" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Effettua una nuova ricarica del conto mensa" android:textColor="#526D88" android:textSize="12sp" android:layout_marginTop="3dp"/>
</LinearLayout><TextView android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="#147BC1" android:textStyle="bold" android:textSize="28sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/dietsCard" android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="10dp" android:background="@drawable/card_pink" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:clickable="true" android:focusable="true">
<ImageView android:layout_width="66dp" android:layout_height="66dp" android:src="@drawable/service_diets" android:scaleType="centerInside"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diete speciali" android:textColor="#0A376B" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Richiedi o gestisci diete per esigenze alimentari" android:textColor="#526D88" android:textSize="12sp" android:layout_marginTop="3dp"/>
</LinearLayout><TextView android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="#147BC1" android:textStyle="bold" android:textSize="28sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/assenzeCard" android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="10dp" android:background="@drawable/card_purple" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:clickable="true" android:focusable="true">
<ImageView android:layout_width="66dp" android:layout_height="66dp" android:src="@drawable/service_absence" android:scaleType="centerInside"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestisci assenze" android:textColor="#0A376B" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Comunica le assenze di tuo figlio/a" android:textColor="#526D88" android:textSize="12sp" android:layout_marginTop="3dp"/>
</LinearLayout><TextView android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="#147BC1" android:textStyle="bold" android:textSize="28sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/dashboardCard" android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="10dp" android:background="@drawable/card_orange" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:clickable="true" android:focusable="true">
<ImageView android:layout_width="66dp" android:layout_height="66dp" android:src="@drawable/service_dashboard" android:scaleType="centerInside"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard mensa" android:textColor="#0A376B" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visualizza pasti, presenze e storico completo" android:textColor="#526D88" android:textSize="12sp" android:layout_marginTop="3dp"/>
</LinearLayout><TextView android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="#147BC1" android:textStyle="bold" android:textSize="28sp"/>
</LinearLayout>
<TextView android:id="@+id/footerAnim" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🥕     🍅     🌿     🥦" android:textSize="24sp" android:gravity="center" android:layout_marginTop="20dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Una mensa più vicina\nalle tue esigenze" android:textColor="#086BB1" android:textStyle="italic" android:textSize="15sp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="15dp"/>
<!-- hidden compatibility buttons are not needed: listeners use cards in V3 -->
</LinearLayout></LinearLayout></ScrollView>